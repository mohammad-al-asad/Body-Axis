{
  "expo": {
    "name": "Body Axis: Move Better",
    "slug": "body-axis",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/app/logo.png",
    "scheme": "bodyaxis",
    "userInterfaceStyle": "automatic",
    "permissions": [
      "BILLING"
    ],
    "owner": "the-body-institute-llc",
    "ios": {
      "icon": "./assets/images/app/logo.png",
      "bundleIdentifier": "com.jointhebodyinstitute.bodyaxis",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationsUsageDescription": "Body Axis needs notification permission to send you workout reminders, progress updates, and activity alerts.",
        "NSCameraUsageDescription": "Body Axis requires access to your camera to take a photo for your profile picture.",
        "NSPhotoLibraryUsageDescription": "Body Axis requires access to your photo library to select and upload a photo for your profile picture.",
        "NSPhotoLibraryAddUsageDescription": "Body Axis requires access to save photos to your photo library.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.72135584288-gf3v957fae48osqpucl7061co7v4vf57"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/app/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jointhebodyinstitute.bodyaxis"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Body Axis requires access to your photo library to select and upload a photo for your profile picture.",
          "cameraPermission": "Body Axis requires access to your camera to take a photo for your profile picture."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0E15",
          "android": {
            "image": "./assets/images/app/blank.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.72135584288-gf3v957fae48osqpucl7061co7v4vf57"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cdd50041-638c-42c3-930e-4407469b35f7"
      }
    }
  }
}
