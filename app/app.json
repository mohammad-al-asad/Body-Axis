{
  "expo": {
    "name": "Body Axis: Move Better",
    "slug": "body-axis",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app/logo.png",
    "scheme": "bodyaxis",
    "userInterfaceStyle": "automatic",
    "permissions": [
      "BILLING"
    ],
    "owner": "the-body-institute-llc",
    "ios": {
      "icon": "./assets/images/app/logo.png",
      "bundleIdentifier": "com.jointhebodyinstitute.bodyaxis",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/app/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jointhebodyinstitute.bodyaxis"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0E15",
          "android": {
            "image": "./assets/images/app/blank.png",
            "imageWidth": 76
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cdd50041-638c-42c3-930e-4407469b35f7"
      }
    }
  }
}
